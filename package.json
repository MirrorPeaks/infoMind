{
    "name": "infomind",
    "version": "1.0.0",
    "description": "个人知识管理系统 - 将网络内容智能分类展示为书架",
    "main": "electron/main.js",
    "bin": {
        "infomind": "./cli/index.js"
    },
    "scripts": {
        "test": "node --test tests/*.test.js",
        "start": "node server/index.js",
        "dev": "NODE_ENV=development node server/index.js",
        "native:electron": "electron-rebuild -f -w better-sqlite3 -v 31.7.7 --build-from-source",
        "desktop": "npm run native:electron && electron .",
        "desktop:deps": "electron-builder install-app-deps",
        "native:node": "npm rebuild better-sqlite3",
        "pack:mac": "npm run native:electron && USE_HARD_LINKS=false electron-builder --mac --dir --config.npmRebuild=false",
        "dist:mac": "npm run native:electron && USE_HARD_LINKS=false electron-builder --mac --config.npmRebuild=false",
        "cli": "node cli/index.js",
        "setup:stt": "bash scripts/setup-stt-macos.sh"
    },
    "keywords": [
        "knowledge",
        "management",
        "bookshelf",
        "openclaw"
    ],
    "author": "InfoMind Team",
    "license": "MIT",
    "dependencies": {
        "@fontsource/manrope": "^5.1.1",
        "@fontsource/newsreader": "^5.1.1",
        "axios": "^1.4.0",
        "better-sqlite3": "^12.10.0",
        "chalk": "^4.1.2",
        "cheerio": "^1.0.0-rc.12",
        "cli-table3": "^0.6.3",
        "commander": "^11.1.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "jsonrepair": "^3.15.0",
        "lucide-static": "^0.468.0",
        "ora": "^5.4.1",
        "uuid": "^9.0.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "electron": "^31.7.7",
        "electron-builder": "^26.8.1"
    },
    "build": {
        "appId": "com.infomind.desktop",
        "productName": "InfoMind",
        "artifactName": "${productName}-${version}-${arch}.${ext}",
        "icon": "build/icon.png",
        "asar": true,
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*"
        ],
        "files": [
            "electron/**/*",
            "server/**/*",
            "public/**/*",
            "extensions/**/*",
            "cli/**/*",
            "openclaw/**/*",
            "deploy/hermes/**/*",
            "scripts/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "data",
                "to": "seed-data",
                "filter": [
                    "**/*",
                    "!*.db-wal",
                    "!*.db-shm"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg",
                "zip"
            ]
        }
    }
}
